{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "version": "1.0.0",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.open-meteo.com/*"],
  "content_scripts": [{ "matches": ["https://news.ycombinator.com/*"], "js": ["content.js"], "css": ["content.css"] }],
  "web_accessible_resources": [{ "resources": ["images/*"], "matches": ["https://news.ycombinator.com/*"] }],
  "sandbox": { "pages": ["sandbox.html"] }
}
